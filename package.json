{
  "name": "whatsapp-chat-button",
  "version": "1.0.0",
  "description": "WhatsApp chat button for your website: one script tag, no dependencies, no tracking.",
  "keywords": [
    "whatsapp",
    "whatsapp-button",
    "whatsapp-widget",
    "whatsapp-chat",
    "click-to-chat",
    "chat-button",
    "floating-button",
    "website-widget",
    "vanilla-js",
    "no-dependencies"
  ],
  "license": "MIT",
  "author": "Replyze (https://replyze.chat)",
  "homepage": "https://replyze.github.io/whatsapp-chat-button/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Replyze/whatsapp-chat-button.git"
  },
  "bugs": {
    "url": "https://github.com/Replyze/whatsapp-chat-button/issues"
  },
  "type": "commonjs",
  "main": "dist/whatsapp-chat-button.min.js",
  "browser": "dist/whatsapp-chat-button.min.js",
  "unpkg": "dist/whatsapp-chat-button.min.js",
  "jsdelivr": "dist/whatsapp-chat-button.min.js",
  "sideEffects": true,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "terser src/whatsapp-chat-button.js --ecma 2018 --compress passes=2 --mangle --comments some --output dist/whatsapp-chat-button.min.js && node scripts/size.cjs",
    "check": "node scripts/check.cjs && publint --strict",
    "test": "node tests/browser.test.cjs",
    "screenshots": "node tests/screenshots.cjs"
  },
  "devDependencies": {
    "playwright": "^1.50.0",
    "publint": "^0.3.25",
    "terser": "^5.36.0"
  }
}
